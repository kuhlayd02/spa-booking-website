generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  duration    Int
  price       Int
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Staff {
  id             String    @id @default(cuid())
  name           String
  specialization String
  bio            String
  bookings       Booking[]
  createdAt      DateTime  @default(now())
}

model Booking {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  serviceId     String
  staffId       String
  date          DateTime
  time          String
  status        BookingStatus @default(PENDING)
  paymentMethod String        @default("CASH")
  notes         String?
  createdAt     DateTime      @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([date])
  @@index([staffId, date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}